# Database Configuration
# For local development (SQLite - no setup needed):
DATABASE_URL=sqlite:///./jlpt_db.db
# For production on Render (PostgreSQL), set this in Render's environment variables:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Configuration (for authentication)
# Generate a secure key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Frontend URL for CORS and redirects
# Use localhost for local development and your deployed frontend URL in production.
FRONTEND_URL=http://localhost:5173