{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jlpt-mock-test-ugp3.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://jlpt-mock-test-ugp3.onrender.com/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
